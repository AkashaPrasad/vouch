TINYFISH_API_KEY=sk-tinyfish-REPLACE_ME
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL=claude-haiku-5-5
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
# python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_ME
# local: sqlite+aiosqlite:///./vouch.db   docker: sqlite+aiosqlite:////data/vouch.db
DATABASE_URL=sqlite+aiosqlite:///./vouch.db
CORS_ORIGINS=https://vouch.spacesdrive.cc,https://vouch-web.pages.dev,http://localhost:5173
TINYFISH_ENABLE_AGENT=true
TINYFISH_AGENT_TIMEOUT_S=150
TINYFISH_SEARCH_TIMEOUT_S=8
TINYFISH_FETCH_TIMEOUT_S=20
ANTHROPIC_TIMEOUT_S=15
PUBLIC_WEB_URL=https://vouch.spacesdrive.cc
TINYFISH_ENABLE_RESEARCH=true
TINYFISH_RESEARCH_MODE=deep
TINYFISH_RESEARCH_TIMEOUT_S=480
TINYFISH_ENABLE_BROWSER=true
TINYFISH_BROWSER_BUDGET_S=60
TINYFISH_ENABLE_MONITOR=true
# Monitor API notifies by webhook only (no email); leave blank to skip
TINYFISH_MONITOR_WEBHOOK_URL=
TINYFISH_HIGHLIGHTS_ENABLED=false
# local: ./screenshots   docker: /data/screenshots
SCREENSHOT_DIR=./screenshots

# agents may take minutes; quality over speed
FINAL_DEADLINE_S=180
FINAL_DEADLINE_LISTING_S=420
TINYFISH_AGENT_MCA=false
PUBLIC_API_URL=https://api.vouch.spacesdrive.cc
